# =============================================================================
# GradeAI Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gradeai
POSTGRES_USER=gradeai
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (S3-compatible) ---
S3_BUCKET_NAME=gradeai-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=http://localhost:9000

# --- AI / LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OCR ---
GOOGLE_CLOUD_VISION_CREDENTIALS=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
